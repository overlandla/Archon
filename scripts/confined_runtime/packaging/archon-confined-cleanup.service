[Unit]
RequiresMountsFor=/var/lib/archon-confined /var/lib/archon-confined-docker
AssertPathIsMountPoint=/var/lib/archon-confined
AssertPathIsMountPoint=/var/lib/archon-confined-docker
Description=Archon durable confined worker cleanup
Requires=archon-confined-docker.service
BindsTo=archon-confined-docker.service
PartOf=archon-confined-docker.service
After=archon-confined-docker.service
Before=archon-confined.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=120
User=archon-confined
Group=archon-confined
UMask=0077
WorkingDirectory=/opt/archon-confined/release
ExecStart=/opt/archon-confined/release/venv/bin/python -I -B /opt/archon-confined/release/scripts/confined_runtime/packaging/entry.py cleanup
StateDirectory=archon-confined
StateDirectoryMode=0700
BindReadOnlyPaths=/run/archon-confined-docker/docker.sock:/run/docker.sock
ReadWritePaths=/var/lib/archon-confined
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LimitCORE=0
LimitNOFILE=256
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
CPUQuota=50%
KillMode=control-group
TimeoutStopSec=35
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=10

[Install]
WantedBy=multi-user.target
